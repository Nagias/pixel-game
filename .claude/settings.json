{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Read", "Edit(./**)", "Bash", "PowerShell", "WebFetch", "WebSearch"],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(del *)",
      "Bash(find * -delete*)",
      "Bash(git rm *)",
      "Bash(git clean*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(ri *)",
      "PowerShell(del *)",
      "PowerShell(rmdir *)",
      "PowerShell(git rm *)",
      "PowerShell(git clean*)",
      "PowerShell(git reset --hard*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(npm publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push origin main*)"
    ]
  }
}
